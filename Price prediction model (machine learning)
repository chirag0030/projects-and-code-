
import pandas as pd
import numpy as np
from sklearn.metrics import mean_squared_error,r2_score,mean_absolute_error
from sklearn.ensemble import RandomForestRegressor
from sklearn.preprocessing import LabelEncoder,StandardScaler
from sklearn.model_selection import train_test_split

## data cleaning
data = pd.read_csv("cars_details2.csv")
df = pd.DataFrame(data)
df.info()
df.shape
df.isnull().sum()
df.dropna(how = "all")
df.duplicated().sum()
df.drop_duplicates(inplace=True)
# print(df["owner"].value_counts())

## preprocession
fuel_encoder = LabelEncoder()
df["fuel"] = fuel_encoder.fit_transform(df["fuel"])

trans_encoder = LabelEncoder()
df["transmission"] = trans_encoder.fit_transform(df["transmission"])

### feature scaling

X = df[["year","km_driven","fuel","transmission"]]
y = df["selling_price"]

scaled = StandardScaler()
x_scaled = scaled.fit_transform(X)

## tain and test the model
X_train,X_test,y_train,y_test = train_test_split(x_scaled,y,random_state=42,test_size=0.2)
                                                                                                        
## model training
model = RandomForestRegressor(
    random_state=42,
    n_estimators=200,
    max_depth=10,
    min_samples_split=5,
    min_samples_leaf=3
    )

model.fit(X_train,y_train)
y_pred = model.predict(X_test)
mae = mean_absolute_error(y_pred,y_test)
print("mean absolute error: ",round(mae,2))
mse = mean_squared_error(y_pred,y_test)
print("mean squared error: ",round(mse,2))
rmse = np.sqrt(mse)
print("root mean squared error: ",round(rmse,2))
r2 = r2_score(y_pred,y_test)
print("r2 score: ",round(r2,2))

## model prediction
def predict_price(year,km_driven,fuel,transmission):
    fuel_value = fuel_encoder.transform([fuel])[0]
    trans_value = trans_encoder.transform([transmission])[0]
    # owner_value = owner_encoder.transform([owner])[0]

    user_input_df = pd.DataFrame([{
        "year":year,
        "km_driven":km_driven,
        "fuel":fuel_value,
        "transmission":trans_value,
        # "owner":owner_value
    }])

    input_scaled = scaled.transform(user_input_df)
    price = model.predict(input_scaled)[0]
    return price

## user input 

year = int(input("enter the year: "))
km_driven = int(input("enter the km_driven: "))
fuel = input("enter the fuel (Petrol/Diesel/CNG): ")
transmission = input("enter the transmission (Manual/Automatic): ")

predicted_selling_price = predict_price(year,km_driven,fuel,transmission)
print(f"according to your input data the predicted selling price will be {predicted_selling_price}")
